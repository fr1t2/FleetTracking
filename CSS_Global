<style>
  /* Base Reset & Fonts */
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
  
  /* THEME 1: LIGHT MODE (Classic & Clean) */
  :root {
    --veo-cyan: #00E5FF; --veo-cyan-dark: #00B8CC;
    --bg-main: #f4f7f6; --bg-surface: #ffffff; --bg-panel: #f8fafc;
    --text-main: #111111; --text-muted: #666666; 
    --border-color: #e2e8f0;
    --status-ready: #34c759; --status-active: #00E5FF; --status-oos: #ff3b30; --status-warn: #ffcc00;
    --shadow: 0 4px 12px rgba(0,0,0,0.05);
    --radius: 8px;
  }

  /* THEME 2: DARK MODE (Professional & Low Eye Strain) */
  [data-theme="dark"] {
    --bg-main: #0a0a0c; --bg-surface: #141417; --bg-panel: #1c1c1f;
    --text-main: #f5f5f7; --text-muted: #a1a1a6; 
    --border-color: #2c2c30;
    --status-ready: #30d158; --status-active: #00E5FF; --status-oos: #ff453a; --status-warn: #ffd60a;
    --shadow: 0 4px 12px rgba(0,0,0,0.4);
  }

  /* THEME 3: VEO DYNAMIC (Cyber/Brand focused) */
  [data-theme="veo-dynamic"] {
    --bg-main: #000000; --bg-surface: #0a0a0a; --bg-panel: #111111;
    --text-main: #ffffff; --text-muted: #888888; 
    --border-color: #00E5FF; /* Cyan borders */
    --status-ready: #00ff73; --status-active: #00E5FF; --status-oos: #ff003c; --status-warn: #ffae00;
    --shadow: 0 0 20px rgba(0, 229, 255, 0.15); /* Glowing cyan shadows */
    --radius: 12px;
  }

  body { background: var(--bg-main); color: var(--text-main); height: 100vh; overflow: hidden; display: flex; flex-direction: column; transition: all 0.3s ease; }
  
  /* Topbar */
  .top-nav { background: var(--bg-surface); border-bottom: 1px solid var(--border-color); padding: 12px 24px; display: flex; justify-content: space-between; align-items: center; z-index: 10; box-shadow: var(--shadow); }
  .brand { font-size: 20px; font-weight: 900; letter-spacing: 1px; color: var(--veo-cyan); display: flex; align-items: center; gap: 10px; }
  
  /* Controls */
  .system-controls { display: flex; gap: 16px; align-items: center; }
  .control-select { background: var(--bg-panel); color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; font-weight: 600; font-size: 13px; outline: none; cursor: pointer; }
  .control-select:focus { border-color: var(--veo-cyan); box-shadow: 0 0 0 2px rgba(0,229,255,0.2); }

  /* Buttons */
  .btn { border: none; padding: 10px 16px; font-size: 13px; font-weight: 700; border-radius: 6px; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; transition: 0.2s; text-transform: uppercase; letter-spacing: 0.5px; }
  .btn-primary { background: var(--veo-cyan); color: #000; }
  .btn-primary:hover { filter: brightness(1.1); box-shadow: 0 0 10px rgba(0,229,255,0.4); }
  
  /* Layout Container */
  #layout-container { flex: 1; overflow: hidden; display: flex; }
  
  /* Global Loader */
  .loader-bar { display:none; height:4px; width:100%; background:var(--veo-cyan); position:absolute; top:0; left:0; z-index:999; animation: loading 1.5s infinite ease-in-out; }
  @keyframes loading { 0% { transform: translateX(-100%); width: 30%; } 50% { transform: translateX(100%); width: 70%; } 100% { transform: translateX(300%); width: 30%; } }
</style>